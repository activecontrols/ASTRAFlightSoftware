<mujoco>
    <!-- Define assets - use the builtin checkerboard texture for the ground plane -->
    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3"
            rgb2=".2 .3 .4" width="300" height="300" mark="none"/>
        <material name="grid" texture="grid" texrepeat="1 1"
            texuniform="true" reflectance=".2"/>
    </asset>

    <!-- Define actual objects in the sim -->
    <worldbody>
        <!-- Define the lighting source-->
        <light name="lightMain" mode = "fixed" pos="0 0 1"/>

        <!-- Define the floor as a plane -->
        <geom name="floor" type="plane" pos="0 0 -.1" size="200 200 .1" material="grid"/>

        <!-- Define the rocket -->
        <!-- I assume you can also attach child bodies to it? not sure how that works -->
        <body name="rocket" pos="0 0 20" euler="0 0 0">
            <!-- Define a light that follows the rocket-->
            <light name="light" mode = "track" pos="0 0 1"/>
            <!-- Define a camera that follows the rocket-->
            <camera name="fixed" mode = "track" pos="0 -1.3 -.1" xyaxes="1 0 0 0 1 2"/>

            <!-- Define joint as free, allowing rocket to move in 6DOF (others include ball, slide, hinge) -->
            <joint name="free" type="free"/>

            <!-- Define the actual geometry - we are just going to use a cylinder -->
            <geom name="body" type="cylinder" pos="0 0 0.0195" size=".1 .3195" rgba="1 0 0 1" mass="10" />

            <!-- Define legs -->
            <body name="leg_1" pos="0 0.1 -0.25" euler="30 0 0">
                <geom name="legbody1" type="cylinder" size=".01 .3" rgba="1 0 0 1" />
            </body>
            <body name="leg_2" pos="0 -0.1 -0.25" euler="-30 0 0">
                <geom name="legbody2" type="cylinder" size=".01 .3" rgba="1 0 0 1" />
            </body>
            <body name="leg_3" pos="-0.1 0 -0.25" euler="0 30 0">
                <geom name="legbody3" type="cylinder" size=".01 .3" rgba="1 0 0 1" />
            </body>
            <body name="leg_4" pos="0.1 0 -0.25" euler="0 -30 0">
                <geom name="legbody4" type="cylinder" size=".01 .3" rgba="1 0 0 1" />
            </body>
                
            <!-- Define an origin TODO: is this the best way? -->
            <site name="rocket_origin" pos="0 0 0" size="0.05"/>

            <!-- Define engine-->
            <body name="engine" pos="0 0 -0.35" euler="0 0 0">
                <joint name="engine_gimbal" type="ball" />
                <geom name="engine" type="cylinder" size=".01 .03" rgba="0 0 1 1" />
                <!-- Define a thrust point for the actuators to attach to -->
                <site name="thrust_point" pos="0 0 -0.05" size="0.01"/>
            </body>

        </body>
    </worldbody>

    <!-- Define the actuator model - we just model it as 3 motors that can apply XYZ forces at the thrust point -->
    <actuator>
        <position name="gimbal_x" joint="engine_gimbal" ctrlrange="-0.35 0.35" kv="0.001" gear="-1 0 0 0 0 0"/>
        <position name="gimbal_y" joint="engine_gimbal" ctrlrange="-0.35 0.35" kv="0.001" gear="0 -1 0 0 0 0"/>
        <motor name="roll" site="rocket_origin" gear="0 0 0 0 0 1"/>
        <motor name="thrust" site="thrust_point" gear="0 0 1 0 0 0"/>
    </actuator>

    <!-- Define the sensor model-->
    <sensor>
        <!-- IMU -->
        <accelerometer name="accel" noise="0.001" site="rocket_origin" />
        <gyro name="imu" noise="0.001" site="rocket_origin" />
        <magnetometer name="mag" noise="0.001" site="rocket_origin" />
    </sensor>
</mujoco>
